.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Provider responses and credentials never belong in source control.
data/raw/
data/cache/
# Private provider snapshots (including SQLite WAL/SHM sidecars).
data/*.sqlite3*
data/automation/
.env
.env.*
!.env.example

# Working live outputs stay local. Only the separately validated derived snapshot
# at publication/live/regime-results.json is eligible for source control.
web/data/regime-results.json
web/data/regime-results.live.json
web/data/regime-results.tmp.json
web/data/.regime-results*.tmp
# No generated research artifacts belong in the source repository. Pages is
# built only from the static allowlist plus the reviewed publication snapshot.
artifacts/
artifacts/latest/
artifacts/baselines/

# Only the verified allowlisted package under dist/ is suitable for publication.
# dist/ and build/ are already ignored above; publish it explicitly, never the repo root.
